---
import Base from '@/layouts/Base.astro';
import GroupBuilder from '@/components/svelte/GroupBuilder.svelte';
---

<!-- Assembles quizzes from this browser's library into a publishable group and downloads it as a
     folder. Under local/ because it reads the LOCAL library — unlike /group, which reads a group
     out of someone's repository. `client:load` because the form is the page. -->
<Base title="Publish a Group">
  <GroupBuilder client:load />
</Base>
