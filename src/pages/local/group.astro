---
import Base from '@/layouts/Base.astro';
import GroupBuilder from '@/components/svelte/GroupBuilder.svelte';
---

<!-- Assembles quizzes from this browser's library into a group: playable here, or downloadable as a
     folder to publish. Under local/ because it reads the LOCAL library — unlike /group, which reads
     a group out of someone's repository.

     `client:only` rather than `client:load` because it reads `?id=` at mount to reopen a saved
     group, exactly as /local/edit does for a quiz — there's no id at build time to prerender
     against. The cost is the same as on every other id-driven page here: layout shift, since
     nothing renders until the island mounts. -->
<Base title="Generate a Group">
  <GroupBuilder client:only="svelte" />
</Base>
