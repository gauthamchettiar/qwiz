---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found">
  <div class="space-y-4 rounded-lg border border-line-subtle bg-surface-raised p-6 text-center">
    <h1 class="text-xl font-bold text-ink">Page not found</h1>
    <p class="text-sm text-ink-subtle">
      There's nothing at this address. If you followed a link to a quiz, it may only exist in the
      browser of whoever shared it — quizzes aren't stored anywhere shared.
    </p>
    <a
      href="/"
      class="inline-block rounded-md bg-accent px-4 py-2 text-sm font-medium text-ink-inverse hover:bg-accent-hover"
    >
      Back to your quizzes
    </a>
  </div>
</Base>
