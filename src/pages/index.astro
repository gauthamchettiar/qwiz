---
import Base from '@/layouts/Base.astro';
import QuizList from '@/components/svelte/QuizList.svelte';
---

<Base title="My Quizzes">
  <div class="space-y-4">
    <div class="border-b border-slate-200 pb-3">
      <h1 class="text-2xl font-bold text-slate-900">Saved</h1>
      <p class="mt-0.5 text-sm text-slate-500">Continue editing a quiz, or open one to explore it.</p>
    </div>
    <QuizList client:load />
  </div>
</Base>
