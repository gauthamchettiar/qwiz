---
import Base from '@/layouts/Base.astro';
import QuizList from '@/components/svelte/QuizList.svelte';
---

<Base title="My Quizzes">
  <div class="space-y-6">
    <div class="space-y-1.5 rounded-lg border border-line-subtle bg-surface p-4">
      <p class="text-sm text-ink-soft">
        Qwiz is a quiz builder and player that runs entirely in your browser — every quiz you create
        is saved to this device's local storage, nothing is ever uploaded anywhere.
      </p>
      <a
        href="https://github.com/gauthamchettiar/qwiz/blob/main/docs/introduction.md"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block text-sm font-medium text-accent-ink hover:text-accent-ink-strong hover:underline"
      >
        Read Docs →
      </a>
    </div>
    <div class="border-b border-line-subtle pb-3">
      <h1 class="text-2xl font-bold text-ink">Saved Quizzes</h1>
      <p class="mt-0.5 text-sm text-ink-subtle">
        Continue editing a quiz, or open one to explore it.
      </p>
    </div>
    <QuizList client:load />
  </div>
</Base>
