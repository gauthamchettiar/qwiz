---
import '@/styles/global.css';
import ImportQuizDialog from '@/components/svelte/ImportQuizDialog.svelte';
import ThemePicker from '@/components/svelte/ThemePicker.svelte';
import Button from '@/components/svelte/Button.svelte';
import Wordmark from '@/components/astro/Wordmark.astro';
import { ArrowLeft } from '@lucide/svelte';

interface Props {
  title?: string;
  description?: string;
  /** Swaps the standard header (logo, Import, + New Quiz) for just a back-to-home link — the
   * play screen's own request to stay out of the way of the quiz itself. */
  minimal?: boolean;
}

const {
  title = 'Qwiz',
  description = 'Build and play quizzes entirely in your browser — nothing leaves your device.',
  minimal = false
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- `initial-scale=1` deliberately without `maximum-scale`/`user-scalable=no`: pinch-zoom
         stays available (removing it is a serious axe violation, and e2e/accessibility.spec.ts
         would fail on it). iOS's auto-zoom-on-focus is addressed in global.css instead, by
         sizing form controls at 16px on touch screens. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#4f39f6" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Qwiz`} />
    <meta property="og:description" content={description} />
    <title>{title} · Qwiz</title>
    <!-- Applies the saved theme BEFORE first paint. It has to be an inline, blocking script in
         <head>: an island can only run after hydration, by which point the page has already been
         painted in the default light theme, and a dark-theme visitor would see a white flash on
         every navigation. Duplicates the few lines of `lib/stores/theme.ts` rather than importing
         it, because a module import is exactly the thing that would make it non-blocking — kept
         to the smallest possible restatement of that one rule, with the store as the source of
         truth for everything else. `is:inline` keeps Astro from bundling it. CSP already allows
         inline scripts for Astro's own islands runtime (see public/_headers). -->
    <script is:inline>
      try {
        const stored = localStorage.getItem('qwiz:theme');
        const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme =
          !stored || stored === 'system' ? (dark ? 'dark' : 'light') : stored;
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body class="min-h-screen">
    <div class="mx-auto max-w-3xl px-4 py-8">
      {
        minimal ? (
          <header class="mb-6 flex items-center justify-between gap-2">
            <a
              href="/"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-soft hover:text-ink"
            >
              <ArrowLeft size={16} /> Back
            </a>
            <ThemePicker client:load />
          </header>
        ) : (
          <header class="mb-8 flex items-center justify-between">
            <a href="/" class="rounded focus-visible:outline-2 focus-visible:outline-offset-4">
              <Wordmark />
            </a>
            <div class="flex items-center gap-2">
              <ThemePicker client:load />
              <ImportQuizDialog client:load />
              <Button href="/local/create" variant="primary" size="sm" client:load>
                + New Quiz
              </Button>
            </div>
          </header>
        )
      }
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
