---
import '@/styles/global.css';
import ImportQuizDialog from '@/components/svelte/ImportQuizDialog.svelte';
import { ArrowLeft } from '@lucide/svelte';

interface Props {
  title?: string;
  description?: string;
  /** Swaps the standard header (logo, Import, + New Quiz) for just a back-to-home link — the
   * play screen's own request to stay out of the way of the quiz itself. */
  minimal?: boolean;
}

const {
  title = 'Qwiz',
  description = 'Build and play quizzes entirely in your browser — nothing leaves your device.',
  minimal = false
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- `initial-scale=1` deliberately without `maximum-scale`/`user-scalable=no`: pinch-zoom
         stays available (removing it is a serious axe violation, and e2e/accessibility.spec.ts
         would fail on it). iOS's auto-zoom-on-focus is addressed in global.css instead, by
         sizing form controls at 16px on touch screens. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#4f39f6" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Qwiz`} />
    <meta property="og:description" content={description} />
    <title>{title} · Qwiz</title>
  </head>
  <body class="min-h-screen">
    <div class="mx-auto max-w-3xl px-4 py-8">
      {
        minimal ? (
          <header class="mb-6">
            <a
              href="/"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-slate-900"
            >
              <ArrowLeft size={16} /> Back
            </a>
          </header>
        ) : (
          <header class="mb-8 flex items-center justify-between">
            <a href="/" class="text-xl font-bold text-slate-900">
              Qwiz
            </a>
            <div class="flex items-center gap-2">
              <ImportQuizDialog client:load />
              <a
                href="/local/create"
                class="rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-indigo-700"
              >
                + New Quiz
              </a>
            </div>
          </header>
        )
      }
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
